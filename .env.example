# CreatorPlus Environment Variables — copy to .env and fill with real values.
# NEVER commit a file containing real secrets.

# Application
PORT=3001
CORS_ORIGIN=http://localhost:3000,http://localhost:3002
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/creatorplus

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# License signing (ES256 / ECDSA P-256). Base64-encoded PEM keys.
# Generate with:
#   node -e "const{generateKeyPairSync}=require('crypto');const{privateKey,publicKey}=generateKeyPairSync('ec',{namedCurve:'P-256'});console.log('PRIV',Buffer.from(privateKey.export({type:'pkcs8',format:'pem'})).toString('base64'));console.log('PUB',Buffer.from(publicKey.export({type:'spki',format:'pem'})).toString('base64'))"
# Keep the PRIVATE key server-side only. If unset, license activation is disabled (everything else works).
LICENSE_SIGNING_PRIVATE_KEY=
LICENSE_SIGNING_PUBLIC_KEY=

# Meilisearch (the code reads *_HOST/*_MASTER_KEY; keep both sets aligned)
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=your-meilisearch-master-key
MEILISEARCH_MASTER_KEY=your-meilisearch-master-key

# Cloudflare R2 (object storage) — fill with your own values, never commit real keys
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=your_bucket_name
R2_BUCKET=your_bucket_name
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://<public-bucket-id>.r2.dev

# Payments — all amounts in the API are Naira (NGN) major units.
# Providers without a configured secret key are hidden from the checkout picker.

# Paystack (primary — Nigeria)
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key

# Flutterwave (pan-African)
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST_your_flutterwave_secret_key

# Stripe (international cards)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_WEBHOOK_SECRET_BILLING=whsec_your_stripe_billing_webhook_secret

# Stripe Price IDs (create these in your Stripe Dashboard)
STRIPE_PRICE_STARTER=price_your_starter_monthly_price_id
STRIPE_PRICE_PRO=price_your_pro_monthly_price_id
STRIPE_PRICE_ENTERPRISE=price_your_enterprise_monthly_price_id

# Email — Brevo (https://brevo.com) is the default provider.
# Use your Brevo SMTP relay credentials:
#   SMTP_USER = the "login" shown in Brevo → Settings → SMTP & API → SMTP key
#   SMTP_PASS = your SMTP key (the full xkeysib-... value)
# Verify the sending domain (mycreatorplus.com) in Brevo → Senders first.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_key
SMTP_FROM=noreply@mycreatorplus.com

# Optional Brevo marketing: when set, new users are upserted into the given
# contact list so you can run campaigns/automations from the Brevo dashboard.
# Find the list id in Brevo → Contacts → Lists.
BREVO_API_KEY=
BREVO_CONTACT_LIST_ID=

# AI (Optional)
OPENAI_API_KEY=sk-your_openai_api_key

# Observability (Optional) — set SENTRY_DSN and `npm i @sentry/node` to enable error tracking
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Background email queue (Optional) — set to 1 to offload email delivery to the
# worker (apps/workers) via BullMQ. Requires REDIS_URL and a running worker.
EMAIL_QUEUE=0

# Platform Settings
COMMISSION_RATE=10
MIN_PAYOUT_AMOUNT=10000
HOLDING_PERIOD_DAYS=14
MAX_FILE_SIZE=104857600
ALLOWED_FILE_TYPES=zip,rar,7z,pdf,doc,docx,ppt,pptx,xls,xlsx,psd,ai,fig,sketch,blend,fbx,obj,stl,mp3,wav,mp4,mov,avi,jpg,jpeg,png,gif,webp
