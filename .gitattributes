# Normalize line endings to LF in the repo (important for Linux/Docker on the VPS)
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf

# Treat binaries as binary (no EOL conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.pdf binary
