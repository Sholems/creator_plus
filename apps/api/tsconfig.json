{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    // NOTE: incremental is explicitly disabled (inherited "true" from the root
    // tsconfig is overridden). With nest-cli's "deleteOutDir": true, an
    // incremental cache outside the deleted dist dir makes tsc skip emitting on
    // rebuilds, so "node dist/main" dies with MODULE_NOT_FOUND and the dev
    // watch process crash-loops. tsc --watch stays incremental in memory.
    "incremental": false,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": false,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": false,
    "noFallthroughCasesInSwitch": false,
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
