{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "declaration": true,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    // Resolve workspace packages (@creatorplus/*) via node_modules → dist
    // instead of the root tsconfig's source-mapped paths (which would pull
    // package sources outside rootDir). Matches apps/api's tsconfig.
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
