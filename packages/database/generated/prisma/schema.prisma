// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// IDENTITY DOMAIN
// ==========================================

model User {
  id               String     @id @default(uuid()) @db.Uuid
  email            String     @unique
  passwordHash     String     @map("password_hash")
  displayName      String?    @map("display_name")
  avatar           String?
  emailVerified    Boolean    @default(false) @map("email_verified")
  twoFactorEnabled Boolean    @default(false) @map("two_factor_enabled")
  twoFactorSecret  String?    @map("two_factor_secret")
  status           UserStatus @default(ACTIVE)
  lastLoginAt      DateTime?  @map("last_login_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")
  deletedAt        DateTime?  @map("deleted_at")

  // Relations
  profile             UserProfile?
  creatorProfile      CreatorProfile?
  affiliate           Affiliate?
  orders              Order[]
  reviews             Review[]
  roles               UserRole[]
  followers           CreatorFollower[]
  cart                Cart?
  downloads           Download[]
  wishlist            Wishlist[]
  wallet              Wallet?
  sessions            Session[]
  subscription        Subscription?
  creditBalance       CreditBalance?
  creditPurchases     CreditPurchase[]
  usageRecords        UsageRecord[]
  notifications       Notification[]
  apiTokens           ApiToken[]
  contactMessages     ContactMessage[]
  supportTickets      SupportTicket[]      @relation("CreatedTickets")
  assignedTickets     SupportTicket[]      @relation("AssignedTickets")
  ticketMessages      TicketMessage[]      @relation("SentTicketMessages")
  passwordResetTokens PasswordResetToken[]
  licenseKeys         LicenseKey[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  bio         String?
  phone       String?
  country     String?
  city        String?
  website     String?
  socialLinks Json?    @map("social_links")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions Permission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  resource    String
  action      String
  createdAt   DateTime @default(now()) @map("created_at")

  roles Role[]

  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  token        String   @unique
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  country      String?
  lastActivity DateTime @default(now()) @map("last_activity")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model ApiToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  name        String
  token       String    @unique
  permissions Json?
  lastUsedAt  DateTime? @map("last_used_at")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_tokens")
}

// ==========================================
// CREATOR DOMAIN
// ==========================================

model CreatorProfile {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  storeName          String             @map("store_name")
  slug               String             @unique
  bio                String?
  avatar             String?
  banner             String?
  verified           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING) @map("verification_status")
  socialLinks        Json?              @map("social_links")
  commissionRate     Decimal?           @map("commission_rate") @db.Decimal(5, 2)
  holdingPeriodDays  Int                @default(14) @map("holding_period_days")
  stripeAccountId    String?            @map("stripe_account_id")
  verifiedAt         DateTime?          @map("verified_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  deletedAt          DateTime?          @map("deleted_at")

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  products     Product[]
  collections  Collection[]
  followers    CreatorFollower[]
  bankAccounts CreatorBankAccount[]
  verification CreatorVerification?

  @@map("creator_profiles")
}

enum VerificationStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

model CreatorVerification {
  id               String             @id @default(uuid()) @db.Uuid
  creatorId        String             @unique @map("creator_id") @db.Uuid
  identityType     String             @map("identity_type")
  identityNumber   String             @map("identity_number")
  identityDocument String             @map("identity_document")
  status           VerificationStatus @default(PENDING)
  reviewedBy       String?            @map("reviewed_by")
  reviewedAt       DateTime?          @map("reviewed_at")
  rejectionReason  String?            @map("rejection_reason")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_verifications")
}

model CreatorBankAccount {
  id            String   @id @default(uuid()) @db.Uuid
  creatorId     String   @map("creator_id") @db.Uuid
  bankName      String   @map("bank_name")
  accountNumber String   @map("account_number")
  accountName   String   @map("account_name")
  swiftCode     String?  @map("swift_code")
  isDefault     Boolean  @default(false) @map("is_default")
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("creator_bank_accounts")
}

model CreatorFollower {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  creatorId String   @map("creator_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([userId, creatorId])
  @@map("creator_followers")
}

// ==========================================
// MARKETPLACE DOMAIN
// ==========================================

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  description String?
  icon        String?
  image       String?
  parentId    String?   @map("parent_id") @db.Uuid
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@map("categories")
}

model Tag {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now()) @map("created_at")

  products ProductTag[]

  @@map("tags")
}

model Collection {
  id          String    @id @default(uuid()) @db.Uuid
  creatorId   String    @map("creator_id") @db.Uuid
  name        String
  slug        String
  description String?
  image       String?
  isPublic    Boolean   @default(true) @map("is_public")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  creator  CreatorProfile      @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  products CollectionProduct[]

  @@unique([creatorId, slug])
  @@map("collections")
}

// ==========================================
// PRODUCT DOMAIN
// ==========================================

model Product {
  id               String        @id @default(uuid()) @db.Uuid
  creatorId        String        @map("creator_id") @db.Uuid
  categoryId       String        @map("category_id") @db.Uuid
  title            String
  slug             String
  description      String
  shortDescription String?       @map("short_description")
  status           ProductStatus @default(DRAFT)
  coverImage       String?       @map("cover_image")
  thumbnail        String?
  previewImages    String[]      @map("preview_images")
  // Optional external link a creator can provide instead of (or alongside) an
  // uploaded file — e.g. a hosted ZIP, Google Drive/Dropbox link, or a landing
  // page. Buyers access it after purchase via their downloads; it is never
  // exposed on public read endpoints.
  deliveryUrl      String?       @map("delivery_url")
  price            Decimal       @db.Decimal(10, 2)
  compareAtPrice   Decimal?      @map("compare_at_price") @db.Decimal(10, 2)
  currency         String        @default("NGN")
  licenseType      LicenseType   @map("license_type")
  version          String        @default("1.0.0")
  fileSize         BigInt        @default(0) @map("file_size")
  downloadCount    Int           @default(0) @map("download_count")
  viewCount        Int           @default(0) @map("view_count")
  rating           Decimal       @default(0) @db.Decimal(3, 2)
  averageRating    Decimal       @default(0) @map("average_rating") @db.Decimal(3, 2)
  reviewCount      Int           @default(0) @map("review_count")
  isFeatured       Boolean       @default(false) @map("is_featured")
  isHeroProduct    Boolean       @default(false) @map("is_hero_product")
  isAffiliatePick  Boolean       @default(false) @map("is_affiliate_pick")
  publishedAt      DateTime?     @map("published_at")

  // Affiliate program. The buyer always pays the same list price whether or not
  // an affiliate was involved — commissions never change the price. The
  // platform always takes its 10% platform fee; the affiliate's reward is
  // deducted from the creator's side, so the creator nets
  // 100 - platformRate - affiliateCommissionRate percent of the commission
  // basis (the amount actually paid after discounts).
  affiliateEnabled         Boolean                @default(false) @map("affiliate_enabled")
  affiliateStatus          ProductAffiliateStatus @default(DISABLED) @map("affiliate_status")
  affiliateCommissionType  String                 @default("RATE") @map("affiliate_commission_type")
  // Creator-selected affiliate reward as a whole percent. MVP range is the
  // discrete set {20, 25, 30, 35, 40, 50}; the effective reward per sale is
  // snapshotted into the CommissionLedger / AffiliateConversion at checkout,
  // so later rate changes can never mutate past commissions.
  affiliateCommissionRate  Int?                   @map("affiliate_commission_rate")
  affiliateApprovedAt      DateTime?              @map("affiliate_approved_at")
  affiliateApprovedBy      String?                @map("affiliate_approved_by") @db.Uuid
  affiliateRejectionReason String?                @map("affiliate_rejection_reason")
  affiliateClickCount      Int                    @default(0) @map("affiliate_click_count")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  creator               CreatorProfile              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  category              Category                    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags                  ProductTag[]
  files                 ProductFile[]
  versions              ProductVersion[]
  reviews               Review[]
  orderItems            OrderItem[]
  collectionProducts    CollectionProduct[]
  wishlistItems         WishlistItem[]
  cartItems             CartItem[]
  downloads             Download[]
  affiliateLinks        AffiliateLink[]
  affiliateClicks       AffiliateClick[]
  affiliateAttributions AffiliateAttribution[]
  promotionalAssets     AffiliatePromotionalAsset[]

  // Optional per-product licensing (activation keys for downloadable apps).
  licenseKeysEnabled    Boolean      @default(false) @map("license_keys_enabled")
  licenseMaxActivations Int          @default(2) @map("license_max_activations")
  licenseValidityDays   Int?         @map("license_validity_days")
  licenseKeys           LicenseKey[]

  @@unique([creatorId, slug])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([rating])
  @@index([createdAt])
  // Composite indexes for the two hottest listing queries: the public catalog
  // (status = PUBLISHED ordered by createdAt) and the creator dashboard
  // (products for a creator filtered by status).
  @@index([status, createdAt])
  @@index([creatorId, status])
  @@map("products")
}

enum ProductStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  PUBLISHED
  ARCHIVED
}

// Whether a product is enabled for the affiliate program, and where it stands
// in the moderation workflow. A creator opts in (PENDING_REVIEW), an admin
// approves (APPROVED) or rejects (REJECTED), can suspend (SUSPENDED), and the
// creator can opt out (DISABLED).
enum ProductAffiliateStatus {
  DISABLED
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum LicenseType {
  PERSONAL
  COMMERCIAL
  EXTENDED
  ENTERPRISE
}

model ProductTag {
  id        String @id @default(uuid()) @db.Uuid
  productId String @map("product_id") @db.Uuid
  tagId     String @map("tag_id") @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_tags")
}

model ProductFile {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @map("product_id") @db.Uuid
  versionId       String?  @map("version_id") @db.Uuid
  fileName        String   @map("file_name")
  fileKey         String   @map("file_key")
  fileSize        BigInt   @map("file_size")
  mimeType        String   @map("mime_type")
  checksum        String?
  storageProvider String   @default("r2") @map("storage_provider")
  createdAt       DateTime @default(now()) @map("created_at")

  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  version ProductVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)

  @@map("product_files")
}

model ProductVersion {
  id            String   @id @default(uuid()) @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  versionNumber String   @map("version_number")
  releaseNotes  String?  @map("release_notes")
  createdAt     DateTime @default(now()) @map("created_at")
  publishedBy   String?  @map("published_by") @db.Uuid

  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  files   ProductFile[]

  @@unique([productId, versionNumber])
  @@map("product_versions")
}

model CollectionProduct {
  id           String   @id @default(uuid()) @db.Uuid
  collectionId String   @map("collection_id") @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@map("collection_products")
}

// ==========================================
// COMMERCE DOMAIN
// ==========================================

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @unique @map("user_id") @db.Uuid
  sessionId String?  @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id          String      @id @default(uuid()) @db.Uuid
  cartId      String      @map("cart_id") @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  licenseType LicenseType @map("license_type")
  quantity    Int         @default(1)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                String            @id @default(uuid()) @db.Uuid
  buyerId           String            @map("buyer_id") @db.Uuid
  status            OrderStatus       @default(PENDING)
  totalAmount       Decimal           @map("total_amount") @db.Decimal(10, 2)
  currency          String            @default("NGN")
  invoiceNumber     String            @unique @map("invoice_number")
  paymentId         String?           @map("payment_id") @db.Uuid
  idempotencyKey    String?           @unique @map("idempotency_key")
  notes             String?
  // Where the buyer came from. AFFILIATE when the order is attributed to an
  // affiliate click; PLATFORM_CAMPAIGN when a platform marketing campaign
  // (utm parameters) is present; otherwise defaults to UNKNOWN. The
  // distinction between creator_direct / marketplace_organic is only used for
  // analytics — every source is charged the same platform fee.
  acquisitionSource AcquisitionSource @default(UNKNOWN) @map("acquisition_source")
  couponCode        String?           @map("coupon_code")
  discountAmount    Decimal?          @map("discount_amount") @db.Decimal(10, 2)
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")

  buyer                User                  @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  items                OrderItem[]
  payment              Payment?
  refunds              Refund[]
  affiliateConversions AffiliateConversion[]
  commissionLedger     CommissionLedger[]
  licenseKeys          LicenseKey[]

  @@index([buyerId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  PROCESSING
  PAID
  FULFILLED
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

/**
 * Where a sale's buyer came from. Recorded on every order and snapshotted into
 * the CommissionLedger for analytics. Money impact is identical across all
 * sources (same 10% platform fee); the value is used for cohort/reporting only.
 */
enum AcquisitionSource {
  CREATOR_DIRECT
  AFFILIATE
  MARKETPLACE_ORGANIC
  PLATFORM_CAMPAIGN
  UNKNOWN
}

model OrderItem {
  id          String      @id @default(uuid()) @db.Uuid
  orderId     String      @map("order_id") @db.Uuid
  productId   String      @map("product_id") @db.Uuid
  productName String      @map("product_name")
  unitPrice   Decimal     @map("unit_price") @db.Decimal(10, 2)
  price       Decimal     @db.Decimal(10, 2)
  quantity    Int         @default(1)
  totalPrice  Decimal     @map("total_price") @db.Decimal(10, 2)
  licenseType LicenseType @map("license_type")
  createdAt   DateTime    @default(now()) @map("created_at")

  order    Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  download Download?

  @@map("order_items")
}

model Payment {
  id                    String        @id @default(uuid()) @db.Uuid
  orderId               String        @unique @map("order_id") @db.Uuid
  amount                Decimal       @db.Decimal(10, 2)
  currency              String        @default("NGN")
  status                PaymentStatus @default(PENDING)
  provider              String
  providerPaymentId     String?       @map("provider_payment_id")
  providerResponse      Json?         @map("provider_response")
  stripeSessionId       String?       @unique @map("stripe_session_id")
  stripePaymentIntentId String?       @map("stripe_payment_intent_id")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Restrict)
  refunds Refund[]

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  REFUNDED
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  orderId          String       @map("order_id") @db.Uuid
  paymentId        String       @map("payment_id") @db.Uuid
  amount           Decimal      @db.Decimal(10, 2)
  reason           String
  status           RefundStatus @default(PENDING)
  providerRefundId String?      @map("provider_refund_id")
  approvedBy       String?      @map("approved_by") @db.Uuid
  approvedAt       DateTime?    @map("approved_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@map("refunds")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

// ==========================================
// DOWNLOADS DOMAIN
// ==========================================

model Download {
  id            String   @id @default(uuid()) @db.Uuid
  orderItemId   String   @unique @map("order_item_id") @db.Uuid
  productId     String   @map("product_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  token         String   @unique
  expiresAt     DateTime @map("expires_at")
  downloadCount Int      @default(0) @map("download_count")
  maxDownloads  Int      @default(10) @map("max_downloads")
  createdAt     DateTime @default(now()) @map("created_at")

  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  logs      DownloadLog[]

  @@map("downloads")
}

model DownloadLog {
  id         String   @id @default(uuid()) @db.Uuid
  downloadId String   @map("download_id") @db.Uuid
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  device     String?
  country    String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")

  download Download @relation(fields: [downloadId], references: [id], onDelete: Cascade)

  @@map("download_logs")
}

// ==========================================
// REVIEWS DOMAIN
// ==========================================

model Review {
  id             String    @id @default(uuid()) @db.Uuid
  productId      String    @map("product_id") @db.Uuid
  buyerId        String    @map("buyer_id") @db.Uuid
  rating         Int
  title          String?
  comment        String?
  helpful        Int       @default(0)
  helpfulCount   Int       @default(0) @map("helpful_count")
  reported       Boolean   @default(false)
