  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  clicks       AffiliateClick[]
  conversions  AffiliateConversion[]
  attributions AffiliateAttribution[]

  @@index([affiliateId])
  @@index([productId])
  @@map("affiliate_links")
}

