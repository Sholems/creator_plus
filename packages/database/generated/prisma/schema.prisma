model SupportTicket {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @map("user_id") @db.Uuid
  subject     String
  description String
  category    TicketCategory
  status      TicketStatus   @default(OPEN)
  priority    TicketPriority @default(MEDIUM)
  assignedTo  String?        @map("assigned_to") @db.Uuid
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  messages       TicketMessage[]
  user           User            @relation("CreatedTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedToUser User?           @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("support_tickets")
}

enum TicketCategory {
  TECHNICAL
  BILLING
  DOWNLOADS
  REFUNDS
  ACCOUNT
  CREATOR_VERIFICATION
  ABUSE_REPORT
}

enum TicketStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TicketMessage {
  id         String           @id @default(uuid()) @db.Uuid
  ticketId   String           @map("ticket_id") @db.Uuid
  senderId   String           @map("sender_id") @db.Uuid
  senderType TicketSenderType @default(USER) @map("sender_type")
  message    String
  createdAt  DateTime         @default(now()) @map("created_at")

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User          @relation("SentTicketMessages", fields: [senderId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@map("ticket_messages")
}

enum TicketSenderType {
  USER
  ADMIN
  SYSTEM
}

model SystemSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  group     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model FeatureFlag {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @unique
  description       String?
  isEnabled         Boolean  @default(false) @map("is_enabled")
  rolloutPercentage Int      @default(100) @map("rollout_percentage")
  environment       String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("feature_flags")
}

model ContactMessage {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  category  String
  message   String
  status    ContactMessageStatus @default(NEW)
  userId    String?              @map("user_id") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("contact_messages")
}

enum ContactMessageStatus {
  NEW
  READ
  ARCHIVED
}

// ==========================================
// BILLING / SUBSCRIPTIONS DOMAIN
// ==========================================

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model Subscription {
  id                   String             @id @default(uuid()) @db.Uuid
  userId               String             @unique @map("user_id") @db.Uuid
  tier                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @unique @map("stripe_subscription_id")
  stripePriceId        String?            @map("stripe_price_id")
  currentPeriodStart   DateTime?          @map("current_period_start")
  currentPeriodEnd     DateTime?          @map("current_period_end")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditPurchases CreditPurchase[]

  @@map("subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  PAUSED
}

model CreditPack {
  id            String   @id @default(uuid()) @db.Uuid
  name          String
  credits       Int
  priceInCents  Int      @map("price_in_cents")
  stripePriceId String?  @unique @map("stripe_price_id")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  purchases CreditPurchase[]

  @@map("credit_packs")
}

model CreditPurchase {
  id                    String               @id @default(uuid()) @db.Uuid
  userId                String               @map("user_id") @db.Uuid
  creditPackId          String               @map("credit_pack_id") @db.Uuid
  subscriptionId        String?              @map("subscription_id") @db.Uuid
  credits               Int
  amountPaidInCents     Int                  @map("amount_paid_in_cents")
  stripePaymentIntentId String?              @map("stripe_payment_intent_id")
  status                CreditPurchaseStatus @default(COMPLETED)
  createdAt             DateTime             @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  creditPack   CreditPack    @relation(fields: [creditPackId], references: [id], onDelete: Restrict)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("credit_purchases")
}

enum CreditPurchaseStatus {
  COMPLETED
  FAILED
  REFUNDED
}

model CreditBalance {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  totalCredits Int       @default(0) @map("total_credits")
  usedCredits  Int       @default(0) @map("used_credits")
  lastTopUpAt  DateTime? @map("last_top_up_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions CreditTransaction[]

  @@map("credit_balances")
}

model CreditTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  balanceId     String                @map("balance_id") @db.Uuid
  type          CreditTransactionType
  amount        Int
  description   String?
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at")

  balance CreditBalance @relation(fields: [balanceId], references: [id], onDelete: Restrict)

  @@map("credit_transactions")
}

enum CreditTransactionType {
  PURCHASE
  USAGE
  REFUND
  BONUS
  EXPIRY
}

model UsageRecord {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  action      String
  creditsUsed Int      @default(1) @map("credits_used")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@map("usage_records")
}

// ==========================================
// LICENSING DOMAIN
// ==========================================

enum LicenseStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// One key per purchased item for license-enabled products. Activations are
/// capped at maxActivations; expiresAt is null for a lifetime license.
model LicenseKey {
  id             String        @id @default(uuid()) @db.Uuid
  key            String        @unique
  productId      String        @map("product_id") @db.Uuid
  orderId        String        @map("order_id") @db.Uuid
  orderItemId    String?       @map("order_item_id") @db.Uuid
  buyerId        String        @map("buyer_id") @db.Uuid
  maxActivations Int           @default(2) @map("max_activations")
  status         LicenseStatus @default(ACTIVE)
  expiresAt      DateTime?     @map("expires_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  product     Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  buyer       User                @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  activations LicenseActivation[]

  @@index([buyerId])
  @@index([productId])
  @@index([orderId])
  @@map("license_keys")
}

/// A single device that has consumed one activation slot of a license key.
model LicenseActivation {
  id           String   @id @default(uuid()) @db.Uuid
  licenseKeyId String   @map("license_key_id") @db.Uuid
  deviceId     String   @map("device_id")
  deviceName   String?  @map("device_name")
  ipAddress    String?  @map("ip_address")
  activatedAt  DateTime @default(now()) @map("activated_at")
  lastSeenAt   DateTime @default(now()) @map("last_seen_at")

  licenseKey LicenseKey @relation(fields: [licenseKeyId], references: [id], onDelete: Cascade)

  @@unique([licenseKeyId, deviceId])
  @@index([licenseKeyId])
  @@map("license_activations")
}
