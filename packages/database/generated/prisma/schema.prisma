  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  product   Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([linkId])
  @@index([affiliateId])
  @@index([productId])
  @@index([visitorId])
  @@map("affiliate_clicks")
}

/**
 * A click attribution. Upserted per (visitor, product): the most recent valid
 * click wins (last-click attribution). When an order for that product is
 * created while the attribution is within its cookie window, the order is
 * recorded here so fulfillment can credit the affiliate exactly once.
 */
model AffiliateAttribution {
  id          String    @id @default(uuid()) @db.Uuid
  affiliateId String    @map("affiliate_id") @db.Uuid
  linkId      String    @map("link_id") @db.Uuid
  productId   String    @map("product_id") @db.Uuid
  visitorId   String?   @map("visitor_id")
  sessionId   String?   @map("session_id")
  ipAddress   String?   @map("ip_address")
  userAgent   String?   @map("user_agent")
  clickedAt   DateTime  @default(now()) @map("clicked_at")
  expiresAt   DateTime  @map("expires_at")
  convertedAt DateTime? @map("converted_at")
  orderId     String?   @map("order_id") @db.Uuid

  affiliate Affiliate     @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  link      AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([visitorId, productId])
  @@index([affiliateId])
  @@index([orderId])
  @@map("affiliate_attributions")
}

/**
 * The affiliate's commission for a single order line. One row per attributed
 * order item; status PENDING (holding period) -> APPROVED (released) ->
 * PAYABLE (eligible for payout) -> PAID (paid out), or REVERSED (refund/fraud),
 * REJECTED, or DISPUTED. Amounts are snapshotted at sale time so later
 * rate/price changes can never mutate what a commission is worth.
 */
model AffiliateConversion {
  id             String           @id @default(uuid()) @db.Uuid
  affiliateId    String           @map("affiliate_id") @db.Uuid
  linkId         String?          @map("link_id") @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  orderItemId    String           @map("order_item_id") @db.Uuid
  orderAmount    Decimal          @map("order_amount") @db.Decimal(10, 2)
  amount         Decimal          @db.Decimal(10, 2)
  rate           Decimal          @default(20) @db.Decimal(5, 2)
  creatorAmount  Decimal          @map("creator_amount") @db.Decimal(10, 2)
  platformAmount Decimal          @map("platform_amount") @db.Decimal(10, 2)
  status         ConversionStatus @default(PENDING)
  heldUntil      DateTime?        @map("held_until")
  releasedAt     DateTime?        @map("released_at")
  // When the conversion becomes eligible for payout (after the holding period).
  payableAt      DateTime?        @map("payable_at")
  // Portion of `amount` already reversed by (partial) refunds. A conversion is
  // fully REVERSED when reversalAmount >= amount; remaining payouts are
  // reduced by the unpaid remainder.
  reversalAmount Decimal          @default(0) @map("reversal_amount") @db.Decimal(10, 2)
  reversedAt     DateTime?        @map("reversed_at")
  reversalReason String?          @map("reversal_reason")
  approvedBy     String?          @map("approved_by") @db.Uuid
  approvedAt     DateTime?        @map("approved_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  link        AffiliateLink?        @relation(fields: [linkId], references: [id], onDelete: SetNull)
  order       Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payoutItems AffiliatePayoutItem[]

  @@unique([orderItemId])
  @@index([affiliateId, status])
  @@index([orderId])
  @@map("affiliate_conversions")
}

enum ConversionStatus {
  PENDING
  APPROVED
  PAYABLE
  PAID
  REVERSED
  REJECTED
  DISPUTED
}

/**
 * Immutable per-order-item record of how every paid naira was split between the
 * platform, the creator, and (optionally) the affiliate. Written once inside
 * the fulfillment transaction; never updated. Backs all commission reporting
 * and reconciliation.
 * Reconciliation invariant: platformAmount + affiliateAmount + creatorAmount
 * always equals the commission basis (paidAmount = gross - discount). The
 * platform fee is always platformRate% of the basis; the affiliate reward is
 * deducted from the creator's share, so creatorRate = 100 - platformRate -
 * affiliateRate. Gateway processing fees are recorded separately and never
 * reduce any party's commission share.
 */
model CommissionLedger {
  id                String            @id @default(uuid()) @db.Uuid
  orderId           String            @map("order_id") @db.Uuid
  orderItemId       String            @map("order_item_id") @db.Uuid
  productId         String            @map("product_id") @db.Uuid
  orderAmount       Decimal           @map("order_amount") @db.Decimal(10, 2)
  discountAmount    Decimal           @default(0) @map("discount_amount") @db.Decimal(10, 2)
  paidAmount        Decimal           @map("paid_amount") @db.Decimal(10, 2)
  platformRate      Decimal           @map("platform_rate") @db.Decimal(5, 2)
  platformAmount    Decimal           @map("platform_amount") @db.Decimal(10, 2)
  affiliateId       String?           @map("affiliate_id") @db.Uuid
  affiliateRate     Decimal?          @map("affiliate_rate") @db.Decimal(5, 2)
  affiliateAmount   Decimal?          @map("affiliate_amount") @db.Decimal(10, 2)
  creatorId         String            @map("creator_id") @db.Uuid
  creatorRate       Decimal           @map("creator_rate") @db.Decimal(5, 2)
  creatorAmount     Decimal           @map("creator_amount") @db.Decimal(10, 2)
  currency          String            @default("NGN")
  acquisitionSource AcquisitionSource @default(UNKNOWN) @map("acquisition_source")
  // Gateway processing fee for this line's payment, kept separate from the
  // platform commission so platform amount is never polluted by processor cost.
  gatewayProvider   String?           @map("gateway_provider")
  gatewayFee        Decimal?          @map("gateway_fee") @db.Decimal(10, 2)
  gatewayCurrency   String?           @map("gateway_currency")
  gatewayReference  String?           @map("gateway_reference")
  createdAt         DateTime          @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([orderItemId])
  @@index([orderId])
  @@index([affiliateId])
  @@index([creatorId])
  @@index([productId])
  @@map("commission_ledger")
}

model AffiliatePayout {
  id          String                @id @default(uuid()) @db.Uuid
  affiliateId String                @map("affiliate_id") @db.Uuid
  amount      Decimal               @db.Decimal(12, 2)
  currency    String                @default("NGN")
  status      AffiliatePayoutStatus @default(PENDING)
  method      String?
  bankDetails Json?                 @map("bank_details")
  reference   String?
  notes       String?
  requestedAt DateTime              @default(now()) @map("requested_at")
  approvedBy  String?               @map("approved_by") @db.Uuid
  approvedAt  DateTime?             @map("approved_at")
  completedAt DateTime?             @map("completed_at")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")

  affiliate Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  items     AffiliatePayoutItem[]

  @@index([affiliateId])
  @@index([status])
  @@map("affiliate_payouts")
}

enum AffiliatePayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

model AffiliatePayoutItem {
  id           String   @id @default(uuid()) @db.Uuid
  payoutId     String   @map("payout_id") @db.Uuid
  conversionId String   @map("conversion_id") @db.Uuid
  amount       Decimal  @db.Decimal(10, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  payout     AffiliatePayout     @relation(fields: [payoutId], references: [id], onDelete: Cascade)
